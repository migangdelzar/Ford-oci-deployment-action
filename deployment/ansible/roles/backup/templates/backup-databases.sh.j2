#!/usr/bin/env bash
set -euo pipefail

backup_root="{{ remote_root }}/backup/archive"
staging_root="{{ remote_root }}/backup/staging"
compose_file="{{ remote_root }}/data/compose.yml"
env_file="{{ remote_root }}/data/.env"
bucket="{{ backup_bucket }}"
namespace="{{ object_storage_namespace }}"
object_prefix="{{ backup_object_prefix | default('ford/backups') }}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
run_id="${timestamp}-$(date +%s%N)-$$"
run_dir="$staging_root/$run_id"
redis_tmp="/tmp/ford-backup-${run_id}.rdb"

mkdir -p "$backup_root" "$run_dir"
cleanup() {
  rm -rf "$run_dir"
}
trap cleanup EXIT

postgres_archive="$run_dir/ford_service_${run_id}.dump.gz"
redis_archive="$run_dir/redis_${run_id}.rdb.gz"
manifest="$run_dir/manifest_${run_id}.json"

docker compose --env-file "$env_file" -f "$compose_file" exec -T postgres \
  pg_dump -U ford -d ford_service --format=custom --no-owner | gzip -9 > "$postgres_archive"

docker compose --env-file "$env_file" -f "$compose_file" exec -T \
  -e REDIS_BACKUP_PATH="$redis_tmp" redis sh -c \
  'set -e; redis-cli --no-auth-warning -a "$REDIS_PASSWORD" --rdb "$REDIS_BACKUP_PATH" >/dev/null; cat "$REDIS_BACKUP_PATH"; rm -f "$REDIS_BACKUP_PATH"' \
  | gzip -9 > "$redis_archive"

sha256_postgres="$(sha256sum "$postgres_archive" | awk '{print $1}')"
sha256_redis="$(sha256sum "$redis_archive" | awk '{print $1}')"
cat > "$manifest" <<EOF
{"created_at":"$timestamp","postgres":"$(basename "$postgres_archive")","postgres_sha256":"$sha256_postgres","redis":"$(basename "$redis_archive")","redis_sha256":"$sha256_redis"}
EOF

oci_put_args=(--auth instance_principal --region "{{ oci_region | default('us-ashburn-1') }}" --namespace-name "$namespace" --bucket-name "$bucket" --force)
oci_head_args=(--auth instance_principal --region "{{ oci_region | default('us-ashburn-1') }}" --namespace-name "$namespace" --bucket-name "$bucket")
upload_and_verify() {
  local object_name="$1" file="$2"
  oci os object put "${oci_put_args[@]}" --name "$object_name" --file "$file" >/dev/null
  oci os object head "${oci_head_args[@]}" --name "$object_name" >/dev/null
}
upload_and_verify "$object_prefix/postgres/$(basename "$postgres_archive")" "$postgres_archive"
upload_and_verify "$object_prefix/redis/$(basename "$redis_archive")" "$redis_archive"
upload_and_verify "$object_prefix/manifests/$(basename "$manifest")" "$manifest"

cp "$postgres_archive" "$backup_root/"
cp "$redis_archive" "$backup_root/"
cp "$manifest" "$backup_root/"
find "$backup_root" -type f \( -name '*.dump.gz' -o -name '*.rdb.gz' -o -name 'manifest_*.json' \) -mtime +7 -delete
printf 'backup_created=%s backup_prefix=%s\n' "$timestamp" "$object_prefix"
