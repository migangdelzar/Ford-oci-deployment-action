services:
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.161.0
    restart: unless-stopped
    command: ["--config=/etc/otelcol-contrib/config.yaml"]
    env_file: [collector.env]
    environment:
      OTEL_DEPLOYMENT_ENVIRONMENT: production
    ports:
      - "127.0.0.1:13133:13133"
    volumes:
      - ./grafana-cloud-config.yaml:/etc/otelcol-contrib/config.yaml:ro
      - {{ docker_container_logs_path }}:/var/lib/docker/containers:ro
    networks: [app_default]

  ford-service-blue:
    image: {{ app_image if app_candidate_slot == 'blue' else app_compose_previous_image }}
    container_name: ford-service-blue
    restart: unless-stopped
    env_file: [.env]
    ports:
      - "127.0.0.1:{{ app_blue_port }}:8080"
    networks: [app_default]

  ford-service-green:
    image: {{ app_image if app_candidate_slot == 'green' else app_compose_previous_image }}
    container_name: ford-service-green
    restart: unless-stopped
    env_file: [.env]
    ports:
      - "127.0.0.1:{{ app_green_port }}:8080"
    networks: [app_default]

  app-proxy:
    image: {{ app_proxy_image | default('nginx@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de') }}
    container_name: ford-service-proxy
    restart: unless-stopped
    network_mode: host
    volumes:
      # Directory mount keeps atomic route-file replacements visible to Nginx.
      - ./nginx:/etc/nginx/conf.d:ro

networks:
  app_default:
    external: true
