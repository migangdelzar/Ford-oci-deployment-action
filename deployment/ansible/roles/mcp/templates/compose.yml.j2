name: ford-mcp

services:
  mcp:
    image: ${MCP_IMAGE:?MCP_IMAGE must be supplied}
    command: ["node", "dist/src/cli.js", "mcp-http"]
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
    environment:
      DATABASE_URL: postgres://ford:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be supplied}@postgres:5432/ford_service?application_name=ford-mcp
      FORD_BASE_URL: https://www.forduruapan.mx
      EMBEDDING_PROVIDER: ollama
      EMBEDDING_API_URL: http://ollama:11434/api/embed
      EMBEDDING_MODEL: qllama/bge-m3:q8_0
      EMBEDDING_DIMENSIONS: "1024"
      MCP_HTTP_HOST: 0.0.0.0
      MCP_HTTP_PORT: "3001"
      MCP_HTTP_BEARER_TOKEN: ${MCP_HTTP_BEARER_TOKEN:?MCP_HTTP_BEARER_TOKEN must be supplied}
      MCP_HTTP_ALLOWED_HOSTS: ford-mcp.emme.business,${EMME_2_PRIVATE_IP},127.0.0.1,localhost
      MCP_HTTP_ALLOWED_ORIGINS: ""
      LANGFUSE_ENVIRONMENT: production
    ports:
      - "${EMME_2_PRIVATE_IP}:3001:3001"
      - "127.0.0.1:3001:3001"
    networks: [data_default]
    depends_on:
      ollama-model:
        condition: service_completed_successfully
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - >-
          fetch('http://127.0.0.1:3001/mcp').then(r => process.exit(r.status === 401 ? 0 : 1)).catch(() => process.exit(1))
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s

  scheduler:
    image: ${MCP_IMAGE:?MCP_IMAGE must be supplied}
    container_name: ford-scraping-scheduler
    restart: unless-stopped
    command: ["node", "dist/src/cli.js", "scheduler"]
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
    environment:
      DATABASE_URL: postgres://ford:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be supplied}@postgres:5432/ford_service?application_name=ford-scraping-scheduler
      FORD_BASE_URL: https://www.forduruapan.mx
      EMBEDDING_PROVIDER: ollama
      EMBEDDING_API_URL: http://ollama:11434/api/embed
      EMBEDDING_MODEL: qllama/bge-m3:q8_0
      EMBEDDING_DIMENSIONS: "1024"
      CRAWL_MAX_PAGES: "1000"
      SYNC_SCHEDULE: "0 12 1 * *"
      SYNC_TIMEZONE: America/Mexico_City
      LANGFUSE_ENVIRONMENT: production
    networks: [data_default]
    depends_on:
      ollama-model:
        condition: service_completed_successfully
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "process.exit(require('node:fs').readFileSync('/proc/1/cmdline').toString().includes('scheduler') ? 0 : 1)"
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 15s

  ollama:
    image: ollama/ollama@sha256:b86366bb528bbf7f1424435d165028497a5b69bf6ddb4fa5a87102e2b79f44fb
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
    environment:
      OLLAMA_NUM_PARALLEL: "1"
      OLLAMA_MAX_LOADED_MODELS: "1"
      OLLAMA_KEEP_ALIVE: 5m
    volumes:
      - ollama-data:/root/.ollama
    ports:
      - "127.0.0.1:11434:11434"
    networks: [data_default]
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 30s

  cloudflared:
    image: cloudflare/cloudflared@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
    restart: unless-stopped
    network_mode: host
    command:
      - tunnel
      - --no-autoupdate
      - run
      - --token-file
      - /etc/cloudflared/tunnel-token
    volumes:
      - "{{ remote_root }}/mcp/cloudflared.token:/etc/cloudflared/tunnel-token:ro"
    depends_on:
      mcp:
        condition: service_healthy
      ollama:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"

  ollama-model:
    image: ollama/ollama@sha256:b86366bb528bbf7f1424435d165028497a5b69bf6ddb4fa5a87102e2b79f44fb
    restart: "no"
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
    environment:
      OLLAMA_HOST: http://ollama:11434
    volumes:
      - ollama-data:/root/.ollama
    networks: [data_default]
    depends_on:
      ollama:
        condition: service_healthy
    entrypoint: ["/bin/sh", "-c"]
    command: ["ollama pull qllama/bge-m3:q8_0"]

volumes:
  ollama-data:

networks:
  data_default:
    external: true
