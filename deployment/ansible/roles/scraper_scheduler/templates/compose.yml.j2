name: ford-scraper-scheduler

services:
  scheduler:
    image: {{ scheduler_candidate_image }}
    container_name: ford-scraping-scheduler
    restart: unless-stopped
    command: ["node", "dist/src/cli.js", "scheduler"]
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
    environment:
      DATABASE_URL: postgres://ford:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be supplied}@postgres:5432/ford_service?application_name=ford-scraping-scheduler
      FORD_BASE_URL: https://www.forduruapan.mx
      EMBEDDING_PROVIDER: ollama
      EMBEDDING_API_URL: http://ollama:11434/api/embed
      EMBEDDING_MODEL: qllama/bge-m3:q8_0
      EMBEDDING_DIMENSIONS: "1024"
      CRAWL_MAX_PAGES: "1000"
      SYNC_SCHEDULE: "0 12 1 * *"
      SYNC_TIMEZONE: America/Mexico_City
      LANGFUSE_ENVIRONMENT: production
    networks: [data_default]
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "process.exit(require('node:fs').readFileSync('/proc/1/cmdline').toString().includes('scheduler') ? 0 : 1)"
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 15s

networks:
  data_default:
    external: true
